
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_RESPONSE_FORMAT=json_object
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=max
LLM_MAX_RETRIES=0

# Feishu notification path (separate from the read-only Bitable settings)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DEMO_CHAT_ID=
FEISHU_BOT_OPEN_ID=
FEISHU_OPERATOR_OPEN_IDS=
FEISHU_NOTIFICATION_DB=outputs/feishu_demo_notifications.sqlite3
# 用于“查看当前结果”的 Wiki 入口；未配置或节点无对应表时回到网页
FEISHU_WIKI_URL=
# auto 探测本机正在运行的 Streamlit；手机/其他电脑访问时改成可达的局域网或公网地址
STREAMLIT_PUBLIC_URL=auto

# 决策推进与写回（可选）。FEISHU_DECISION_RUN_ROOT 指向 coordinator run 根目录（含 active.json）。
# FEISHU_RUNLOG_URL / FEISHU_RESULTS_URL 为同一个 Base 内两张模板表的完整链接（含 ?table=）。
# 网页端确认“连接助手”后，会在同一 Base 创建本轮两张空白写回表，旧表保留。
# 运行日志模板字段：run_id, action, actor_open_id, summary, created_at
# 结果模板字段：run_id, record_kind, record_key, content, created_at
FEISHU_DECISION_RUN_ROOT=
FEISHU_RUNLOG_URL=
FEISHU_RESULTS_URL=
# 写回/决策门队列数据库，默认与通知库同目录
FEISHU_WRITEBACK_DB=
FEISHU_GATE_DB=

# 决策门模式：coordinator=正式 run（需 active.json）；replay=读取演化 run 冻结产物零模型演示
FEISHU_GATE_MODE=coordinator
FEISHU_REPLAY_STATE_PATH=outputs/feishu_replay_state.json
